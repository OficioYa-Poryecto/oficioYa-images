# Copiar a .env (ignorado por git) y llenar. Spring lo lee al arrancar desde esta carpeta.
MONGODB_URI=mongodb://localhost:27017/oficioya_images
# Misma clave Base64 con la que Identity firma los tokens (minimo 32 bytes decodificados)
JWT_SECRET=
# Opcional, por defecto 8083
PORT=8083
# Origenes del front que pueden llamar al servicio, separados por coma (opcional)
CORS_ALLOWED_ORIGINS=http://localhost:5173
